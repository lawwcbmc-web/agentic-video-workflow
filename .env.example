# Director / LLM
OPENAI_API_KEY=
OPENAI_MODEL=
ALLOW_AI_SCRIPTING=false

# Local prompt-to-video server
PORT=3000

# n8n
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=

# Pixelle-Video (self-hosted or reachable API)
# Example: http://127.0.0.1:8000
PIXELLE_API_URL=
# Required by Pixelle's video API, e.g. 1080x1920/image_default.html
PIXELLE_FRAME_TEMPLATE=
PIXELLE_MEDIA_WORKFLOW=
PIXELLE_TTS_WORKFLOW=
PIXELLE_API_KEY=

# Optional paid providers (placeholders only)
HEYGEN_API_KEY=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Publishing placeholders
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Safety: keep false until a human explicitly approves each job
ALLOW_PAID_GENERATION=false
ALLOW_PUBLISHING=false
