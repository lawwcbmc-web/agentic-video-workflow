{
  "name": "agentic-video-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "start": "node --import tsx src/server.ts",
    "validate": "node --import tsx src/orchestrator.ts validate jobs/sample-job.json",
    "plan": "node --import tsx src/orchestrator.ts plan jobs/sample-job.json",
    "assets": "node --import tsx src/orchestrator.ts assets jobs/sample-job.json",
    "render": "remotion render src/remotion/index.ts MainVideo out/video.mp4 --props=jobs/sample-job.json",
    "render:assets": "remotion render src/remotion/index.ts MainVideo out/video-with-assets.mp4 --props=out/sample-stroke-awareness.assets.json",
    "check:ffmpeg": "node scripts/check-ffmpeg.mjs",
    "typecheck": "tsc --noEmit",
    "test:generator": "node --import tsx src/generator.test.ts",
    "test": "npm run typecheck && npm run validate && npm run test:generator && npm run check:ffmpeg"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "ajv": "^8.17.1",
    "openai": "^5.0.0",
    "remotion": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
