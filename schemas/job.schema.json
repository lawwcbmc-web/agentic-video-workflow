{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/video-job.schema.json",
  "title": "Agentic video job",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "objective", "audience", "format", "scenes", "approvals"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 3},
    "objective": {"type": "string", "minLength": 10},
    "audience": {"type": "string", "minLength": 3},
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps"],
      "properties": {
        "width": {"type": "integer", "minimum": 320},
        "height": {"type": "integer", "minimum": 320},
        "fps": {"type": "integer", "minimum": 15, "maximum": 60}
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "durationSeconds", "heading", "body"],
        "properties": {
          "id": {"type": "string"},
          "durationSeconds": {"type": "number", "exclusiveMinimum": 0},
          "heading": {"type": "string"},
          "body": {"type": "string"},
          "voiceover": {"type": "string"},
          "assetPrompt": {"type": "string"},
          "visual": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": {"enum": ["text", "image", "video", "chart", "presenter"]},
              "prompt": {"type": "string"},
              "source": {"type": "string"},
              "provider": {"enum": ["none", "pixelle", "local", "heygen", "canva"]}
            }
          },
          "audio": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {"type": "string"},
              "provider": {"enum": ["none", "pixelle", "local"]}
            }
          },
          "citations": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"type": "string"}},
          "evidenceExcerpts": {"$ref": "#/$defs/evidenceExcerpts"},
          "generation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": {"enum": ["pending", "generated", "failed"]},
              "requestId": {"type": "string"},
              "estimatedCostUsd": {"type": "number", "minimum": 0},
              "error": {"type": "string"}
            }
          }
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "presenter": {"enum": ["none", "heygen-placeholder"]},
        "design": {"enum": ["none", "canva-placeholder"]},
        "media": {"enum": ["none", "pixelle"]},
        "voice": {"enum": ["none", "pixelle"]}
      }
    },
    "evidence": {"$ref": "#/$defs/evidenceBundle"},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factual", "clinical"],
      "properties": {
        "factual": {"enum": ["pending", "approved", "rejected"]},
        "clinical": {"enum": ["pending", "approved", "rejected"]},
        "contentSnapshot": {"type": "string", "minLength": 1}
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brief", "paidGeneration", "publish"],
      "properties": {
        "brief": {"enum": ["pending", "approved", "rejected"]},
        "paidGeneration": {"enum": ["pending", "approved", "rejected"]},
        "publish": {"enum": ["pending", "approved", "rejected"]}
      }
    }
  },
  "$defs": {
    "evidenceExcerpts": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string",
            "minLength": 20,
            "maxLength": 2000
          }
        },
        "required": [
          "sourceId",
          "excerpt"
        ]
      }
    },
    "evidenceBundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "europe-pmc"
        },
        "query": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "retrievedAt": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^pubmed-[1-9][0-9]{0,8}$"
              },
              "pmid": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,8}$"
              },
              "doi": {
                "type": "string",
                "pattern": "^10\\.[0-9]{4,9}/\\S+$"
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "authors": {
                "type": "string",
                "minLength": 1
              },
              "journal": {
                "type": "string",
                "minLength": 1
              },
              "year": {
                "type": "integer",
                "minimum": 1900,
                "maximum": 2100
              },
              "abstract": {
                "type": "string",
                "minLength": 20,
                "maxLength": 30000
              },
              "publicationTypes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "pmid",
              "url",
              "title",
              "authors",
              "journal",
              "year",
              "abstract",
              "publicationTypes"
            ]
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checkedAt": {
              "type": "string",
              "minLength": 1
            },
            "snapshot": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "checkedAt",
            "snapshot"
          ]
        }
      },
      "required": [
        "provider",
        "query",
        "retrievedAt",
        "sources"
      ]
    }
  }
}
